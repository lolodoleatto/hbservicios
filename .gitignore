# Dependencies
node_modules/

# Build output — frontend/dist SÍ se sube: el build combinado de los dos
# proyectos no entra en el tiempo de build del hosting, así que el frontend
# se compila en local antes de cada deploy y se commitea ya listo (ver
# "build:full" en package.json). El backend en cambio SÍ se recompila en
# el propio hosting (más liviano por sí solo), así que backend/dist sigue
# ignorado como antes.
dist/
dist-ssr/
build/
!frontend/dist/

# Env files (keep .env.example tracked)
.env
.env.*
!.env.example

# Logs
*.log
npm-debug.log*

# Editor / OS
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
*.sw?

# Docs (interno, no se sube al repositorio)
docs/
